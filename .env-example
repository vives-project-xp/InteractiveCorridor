# Gebruikersnaam voor MySQL.
MYSQL_USER=corridor

# Wachtwoord voor de MySQL-gebruiker.
MYSQL_PASSWORD=CHANGE-ME

# Naam van de database.
MYSQL_DATABASE=corridor

# URL van de MQTT-broker container.
MQTT_HOST=mqtt://mosquitto

# Poort van de MQTT-broker.
MQTT_PORT=1883

# Gebruikersnaam voor verbinding met de MQTT-broker.
MQTT_USERNAME=ICorridor

# Wachtwoord voor verbinding met de MQTT-broker.
MQTT_PASSWORD=CHANGE-ME

# Basistopic voor MQTT.
MQTT_BASE_TOPIC=PM/IC/

# Tijd waarop de LED's aangaan (bijv. 8 uur 's ochtends).
START_TIME=8:00

# Tijd waarop de LED's uitgaan (bijv. 22 uur 's avonds).
END_TIME=22:00

# Verschil tussen lokale tijd en UTC-tijd (bijv. +2 uur voor Central European Time).
UTC_DIFF=2

# URL van de backend-server.
BACKEND_URL=http://corridor.devbit.lan

# Poort van de backend-server.
BACKEND_PORT=3000

# Poort van de frontend-server.
FRONTEND_PORT=80

# Tijd in minuten voordat de ledstrips naar hun standaard effect gaan.
TIMEOUT_TIME=1

# Standaard effect voor de ledstrips.
DEFAULT_EFFECT_NAME=default

# Aantal ledstrips die aanwezig zijn.
LEDSTRIP_COUNT=5

# Wachtwoord om admin mode te activeren
ADMIN_PASSWORD=CHANGE-ME

# Lijst van effecten die niet mogen worden afgespeeld. (GESPLITST DOOR EEN KOMMA!) https://kno.wled.ge/features/effects/
EFFECT_BLACKLIST=23,24,25,42,66,79,82,90,99,118,119,120,121,122,123,124,125,126,127,139,146,149,150,152,153,154,160,162,163,164,165,166,167,168,172,173,174,175,176,177,178,180,181,182,183,186,187
